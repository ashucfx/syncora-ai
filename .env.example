# =============================================================
# SYNCORA — Environment Variables
# Copy this file to .env.local and fill in your values
# =============================================================

# ─────────────────────────────────────────────
# APP
# ─────────────────────────────────────────────
NEXT_PUBLIC_APP_URL=http://localhost:3000
NODE_ENV=development

# ─────────────────────────────────────────────
# DATABASE (Supabase)
# Use the pooler URL (port 6543) for DATABASE_URL in production
# Use the direct URL (port 5432) for DIRECT_URL (migrations only)
# ─────────────────────────────────────────────
DATABASE_URL=postgresql://postgres:your_password@db.your-project.supabase.co:6543/postgres?pgbouncer=true
DIRECT_URL=postgresql://postgres:your_password@db.your-project.supabase.co:5432/postgres

# Local dev (Docker):
# DATABASE_URL=postgresql://postgres:syncora_dev_password@localhost:5432/syncora
# DIRECT_URL=postgresql://postgres:syncora_dev_password@localhost:5432/syncora

# ─────────────────────────────────────────────
# SUPABASE AUTH
# ─────────────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key

# ─────────────────────────────────────────────
# REDIS (BullMQ)
# ─────────────────────────────────────────────
REDIS_URL=redis://localhost:6379
# Production: REDIS_URL=redis://default:password@your-redis-host:6379

# ─────────────────────────────────────────────
# PAYMENT PROVIDERS
# Only configure providers you plan to use
# ─────────────────────────────────────────────

# Stripe
STRIPE_SECRET_KEY=sk_test_...
STRIPE_PUBLISHABLE_KEY=pk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...

# Razorpay
RAZORPAY_KEY_ID=rzp_test_...
RAZORPAY_KEY_SECRET=your_razorpay_secret
RAZORPAY_WEBHOOK_SECRET=your_razorpay_webhook_secret

# ─────────────────────────────────────────────
# AI PROVIDERS
# ─────────────────────────────────────────────
OPENAI_API_KEY=sk-...
ANTHROPIC_API_KEY=sk-ant-...

# ─────────────────────────────────────────────
# EMAIL (Resend — recommended for transactional)
# ─────────────────────────────────────────────
RESEND_API_KEY=re_...
EMAIL_FROM=noreply@yourdomain.com

# ─────────────────────────────────────────────
# STORAGE (Supabase Storage — S3-compatible)
# ─────────────────────────────────────────────
SUPABASE_STORAGE_BUCKET=syncora-files

# ─────────────────────────────────────────────
# N8N WEBHOOK
# URL of your n8n instance for receiving Supabase events
# ─────────────────────────────────────────────
N8N_WEBHOOK_BASE_URL=http://localhost:5678/webhook
N8N_ENCRYPTION_KEY=change-this-to-a-random-32-char-string

# ─────────────────────────────────────────────
# MONITORING
# ─────────────────────────────────────────────
SENTRY_DSN=https://...@sentry.io/...
NEXT_PUBLIC_SENTRY_DSN=https://...@sentry.io/...

# ─────────────────────────────────────────────
# FEATURE FLAGS (GrowthBook)
# ─────────────────────────────────────────────
NEXT_PUBLIC_GROWTHBOOK_API_HOST=http://localhost:3100
NEXT_PUBLIC_GROWTHBOOK_CLIENT_KEY=sdk-...
